---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  title="Page not found - Orestis Ioannou"
  description="The requested page could not be found."
  canonicalPath="/404"
>
  <section class="mx-auto flex min-h-[65vh] max-w-xl flex-col justify-center py-20 text-center">
    <p class="section-kicker">404</p>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">This page does not exist.</h1>
    <p class="section-intro">The link may be old, or the page may have moved.</p>
    <a href="/" class="mt-6 font-semibold text-foreground hover:text-primary">Return home →</a>
  </section>
</BaseLayout>
