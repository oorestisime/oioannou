---
import BaseLayout from "../layouts/BaseLayout.astro"
import { canonicalUrl } from "../lib/seo"

interface GithubRepo {
  id: number
  name: string
  description: string | null
  html_url: string
  homepage: string | null
  stargazers_count: number
  language: string | null
  fork: boolean
}

let repos: GithubRepo[] = []
try {
  const response = await fetch("https://api.github.com/users/oorestisime/repos?sort=updated&per_page=10", {
    headers: { Accept: "application/vnd.github+json", "User-Agent": "oioannou.com-build" },
  })
  if (response.ok) {
    const data = (await response.json()) as GithubRepo[]
    repos = data
      .filter((repo) => !repo.fork && repo.name !== "RSA_ElGamal")
      .sort((a, b) => b.stargazers_count - a.stargazers_count)
      .slice(0, 6)
  }
} catch {
  // The page remains useful with the direct GitHub profile link if the build-time API is unavailable.
}

const title = "Projects - Orestis Ioannou"
const description = "Open source projects and personal work by Orestis Ioannou"
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  headline: title,
  description,
  url: canonicalUrl("/projects"),
}
---

<BaseLayout title={title} description={description} canonicalPath="/projects" image="/img/me.jpg" schema={schema}>
  <section class="py-16 sm:py-20">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="section-kicker">Open source</p>
      <h1 class="text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">Projects and experiments</h1>
      <p class="section-intro">A build-time snapshot of recent public work. The homepage remains focused on selected professional themes.</p>
    </div>
    {repos.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {repos.map((repo) => (
          <article class="flex h-full flex-col rounded-lg border border-border bg-card p-6 transition-colors hover:border-primary/50">
            <div class="mb-4 flex items-start justify-between gap-4">
              <h2 class="text-xl font-semibold tracking-tight">
                <a href={repo.html_url} target="_blank" rel="noopener noreferrer">{repo.name}</a>
              </h2>
              <span class="shrink-0 text-xs text-muted-foreground">★ {repo.stargazers_count}</span>
            </div>
            <p class="my-0 flex-1 text-sm leading-6 text-muted-foreground">{repo.description || "Public repository on GitHub."}</p>
            <div class="mt-6 flex items-center justify-between gap-4 border-t border-border pt-4 text-xs text-muted-foreground">
              <span>{repo.language || "Mixed"}</span>
              {repo.homepage && (
                <a href={repo.homepage} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1">
                  Visit project
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mx-auto max-w-xl rounded-xl border border-border bg-card p-8 text-center">
        <p class="my-0 text-muted-foreground">The repository snapshot was unavailable during this build.</p>
        <a href="https://github.com/oorestisime" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1 font-semibold">
          View GitHub profile
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      </div>
    )}
  </section>
</BaseLayout>
