---
import BaseLayout from "../layouts/BaseLayout.astro"
import { canonicalUrl } from "../lib/seo"

const title = "Work with me - Orestis Ioannou"
const description =
  "Part-time contract work setting up the foundations for teams to use AI effectively: context before the PR, review and AI security checks to merge more, and company agents so support and marketing stop waiting on engineering. Cyprus and Europe."
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  headline: title,
  description,
  url: canonicalUrl("/work-with-me"),
}

const booking = "https://cal.com/oorestisime/30min"
const email = "mailto:oorestisime@gmail.com?subject=Intro%20call"

const stats = [
  { value: "1.4x", label: "merged PRs at Bold.org", detail: "Same headcount, Q3 2026 vs Q3 2025" },
  { value: "5B+", label: "tokens a month on Sherlog", detail: "The internal agent every team at Bold.org works with" },
  { value: "9M+", label: "users at Bold.org", detail: "Scaled from the earliest days to VP of Tech" },
]

const mergedPrs = [
  { quarter: "Q1", year: "2025", value: 322 },
  { quarter: "Q2", year: "", value: 270 },
  { quarter: "Q3", year: "", value: 331, compare: true },
  { quarter: "Q4", year: "", value: 299 },
  { quarter: "Q1", year: "2026", value: 344 },
  { quarter: "Q2", year: "", value: 320 },
  { quarter: "Q3", year: "", value: 448, highlight: true },
]
const prMax = 480

const contributions = [
  { role: "Full Stack Engineer", period: "2020 to 2022", value: 173 },
  { role: "Principal Engineer", period: "2022 to 2025", value: 114 },
  { role: "VP of Technology", period: "2025", value: 111 },
  { role: "VP of Technology, with agents", period: "2026", value: 213, highlight: true },
]
const contributionMax = 230

const roles = [
  {
    role: "Designers",
    text: "Run their own analytics and see how people actually use what they designed.",
  },
  {
    role: "Product managers",
    text: "Have all the data in one place, so decisions are better informed and faster.",
  },
  {
    role: "Support",
    text: "Investigates customer reports end to end. What took hours and three or four people now takes under an hour.",
  },
  {
    role: "Fraud checks",
    text: "Run automatically, instead of waiting for someone to have time.",
  },
  {
    role: "Marketing and growth",
    text: "Get their own numbers and dashboards without filing a ticket.",
  },
  {
    role: "Engineers",
    text: "Debug production with events, logs, tickets and code in one conversation.",
  },
]

const moreProof = [
  {
    value: "3 weeks",
    text: "An API contract migration run by coordinated agents as a side project. Nobody would have done it by hand.",
  },
  {
    value: "-72%",
    text: "Periscope replaced with ClickHouse and Grafana, agents rebuilding the dashboards. $2,000 a month became $550.",
  },
]

const stalls = [
  {
    stage: "Before the PR",
    stall: "Agents don't know your company. They know TypeScript, not your production data, tickets or past decisions.",
    fix: "Agents connected to your code, tickets, docs and production data, so problems get investigated and scoped before anyone writes code.",
  },
  {
    stage: "Review",
    stall: "More PRs, same reviewers. Plausible but overbuilt agent code piles up waiting for someone to trust it.",
    fix: "Project instructions, automated checks and review workflows that keep agent code simple, so more of it lands and less comes back.",
  },
  {
    stage: "Security",
    stall: "More code ships faster, and security review doesn't scale with it.",
    fix: "AI security checks in the pipeline on every change, and agents with read-only, scoped access and no credentials.",
  },
  {
    stage: "Across the company",
    stall: "Support needs an engineer to look into a report. Marketing needs one for a number. Engineering is everyone's queue.",
    fix: "A company agent in Slack and Linear, where people already work, connected to your data and tools. Every role can do more than its job title.",
  },
]

const steps = [
  {
    step: "01",
    title: "Intro call",
    tag: "Free",
    description: "We talk about your goals, your team and where work gets stuck. No prep needed.",
  },
  {
    step: "02",
    title: "Plan and quote",
    tag: "Within a week",
    description: "A written plan: what to set up first, how long it takes and what it costs. You decide from there.",
  },
  {
    step: "03",
    title: "Build together",
    tag: "A few weeks",
    description: "I set up the foundations in your environment with your team, on real work, not a demo.",
  },
  {
    step: "04",
    title: "Hand over",
    tag: "Optional support after",
    description: "Training, docs and a clear way to contribute. Your team owns it and keeps extending it without me.",
  },
]

const posts = [
  { title: "AI Promised Less Work", href: "/blog/ai-promised-less-work/" },
  { title: "Building an Internal Company Agent", href: "/blog/internal-company-agent-lessons/" },
  { title: "I Still Read the Code", href: "/blog/i-still-read-the-code/" },
]
---

<BaseLayout title={title} description={description} canonicalPath="/work-with-me" image="/img/me.jpg" schema={schema}>
  <!-- Hero -->
  <section class="relative py-14 sm:py-20 lg:py-24">
    <div class="pointer-events-none absolute -left-40 top-0 size-96 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="relative grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <div>
        <p class="m-0 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          <span class="size-2 rounded-full bg-primary"></span>
          Taking on 2 part-time engagements
        </p>
        <h1 class="mb-0 mt-6 text-4xl font-semibold leading-[1.05] tracking-[-0.045em] sm:text-6xl">
          AI that makes your whole team ship faster, <span class="text-primary">not just busier.</span>
        </h1>
        <p class="mb-0 mt-6 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl">
          I come in as a contractor and set up the foundations for your team to use AI well: before the PR, in review,
          in security and across the company.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={booking} class="group inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-base font-semibold text-primary-foreground hover:bg-primary/90 hover:text-primary-foreground">
            Book a free intro call
            <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <a href={email} class="text-sm font-semibold text-foreground hover:text-primary">or email me</a>
          <a href="#results" class="text-sm font-semibold text-muted-foreground hover:text-primary">See the results ↓</a>
        </div>
      </div>
      <aside class="-mt-4 lg:mt-0">
        <div class="flex items-center gap-4 overflow-hidden rounded-2xl border border-border bg-card p-3 shadow-2xl shadow-black/30 lg:block lg:p-0">
          <img src="/img/me.jpg" alt="Illustration of Orestis Ioannou" class="size-16 shrink-0 rounded-xl object-cover lg:aspect-square lg:size-auto lg:w-full lg:rounded-none" width="1024" height="1024" />
          <div class="lg:p-5">
            <p class="m-0 text-base font-semibold lg:text-lg">Orestis Ioannou</p>
            <p class="m-0 mt-0.5 text-sm text-muted-foreground lg:mt-1">VP of Technology at Bold.org</p>
            <p class="m-0 text-sm text-muted-foreground lg:hidden">Cyprus in person · Europe remote</p>
            <p class="m-0 mt-4 hidden border-t border-border pt-4 text-sm leading-6 text-muted-foreground lg:block">
              Cyprus, in person<br />Europe, remote
            </p>
          </div>
        </div>
      </aside>
    </div>

    <dl class="relative m-0 mt-14 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3">
      {stats.map((stat) => (
        <div class="bg-background p-5 sm:p-6">
          <dt class="sr-only">{stat.label}</dt>
          <dd class="m-0">
            <span class="block font-mono text-4xl font-semibold tracking-tight text-primary sm:text-5xl">{stat.value}</span>
            <span class="mt-2 block text-sm font-semibold text-foreground">{stat.label}</span>
            <span class="mt-1 block text-xs leading-5 text-muted-foreground">{stat.detail}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Results -->
  <section id="results" class="scroll-mt-20 border-t border-border py-16 sm:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="section-kicker">Results</p>
      <h2 class="section-title">Same team. 1.4x the merged PRs.</h2>
      <p class="section-intro">
        This is what the foundations did at Bold.org, where I'm VP of Technology. Headcount didn't change.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[3fr_2fr]">
      <figure class="m-0 rounded-xl border border-border bg-card p-6 sm:p-8">
        <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="text-base font-semibold">Merged PRs per quarter, Bold.org</span>
          <span class="font-mono text-xs text-muted-foreground">331 → 448</span>
        </figcaption>
        <div class="mt-8 flex h-56 items-end gap-2 sm:gap-4" role="img" aria-label="Merged pull requests per quarter at Bold.org: 322, 270, 331, 299 in 2025 and 344, 320, 448 in 2026.">
          {mergedPrs.map((bar) => (
            <div class="flex h-full flex-1 flex-col items-center justify-end" aria-hidden="true">
              <span class:list={["mb-2 font-mono text-xs", bar.highlight ? "font-semibold text-primary" : "text-muted-foreground"]}>{bar.value}</span>
              <div
                class:list={[
                  "w-full max-w-12 rounded-t-md",
                  bar.highlight ? "bg-primary" : bar.compare ? "bg-primary/35" : "bg-foreground/15",
                ]}
                style={`height: ${(bar.value / prMax) * 100}%`}
              ></div>
            </div>
          ))}
        </div>
        <div class="mt-3 flex gap-2 border-t border-border pt-3 sm:gap-4" aria-hidden="true">
          {mergedPrs.map((bar) => (
            <div class="flex-1 text-center font-mono text-xs leading-5 text-muted-foreground">
              {bar.quarter}
              {bar.year && <span class="block">{bar.year}</span>}
            </div>
          ))}
        </div>
        <p class="mb-0 mt-5 text-xs leading-5 text-muted-foreground">
          Bold.org monorepo. The internal agent's code moved into this repo in February 2026, so it only counts on the
          2026 side.
        </p>
      </figure>

      <figure class="m-0 flex flex-col rounded-xl border border-border bg-card p-6 sm:p-8">
        <figcaption class="text-base font-semibold">My GitHub contributions per month</figcaption>
        <p class="mb-0 mt-2 text-sm leading-6 text-muted-foreground">As VP, I'm back above my full-stack engineer pace.</p>
        <div class="mt-6 flex flex-1 flex-col justify-center gap-5" role="img" aria-label="Average monthly GitHub contributions: 173 as Full Stack Engineer, 114 as Principal Engineer, 111 as VP of Technology in 2025, about 213 as VP of Technology with agents in 2026.">
          {contributions.map((row) => (
            <div aria-hidden="true">
              <div class="flex items-baseline justify-between gap-3 text-sm">
                <span class:list={[row.highlight ? "font-semibold text-foreground" : "text-muted-foreground"]}>
                  {row.role} <span class="text-xs text-muted-foreground">{row.period}</span>
                </span>
                <span class:list={["font-mono text-xs", row.highlight ? "font-semibold text-primary" : "text-muted-foreground"]}>{row.value}</span>
              </div>
              <div class="mt-2 h-2.5 rounded-full bg-foreground/5">
                <div class:list={["h-full rounded-full", row.highlight ? "bg-primary" : "bg-foreground/20"]} style={`width: ${(row.value / contributionMax) * 100}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <a href="/blog/ai-promised-less-work/" class="mt-6 text-sm font-semibold text-foreground hover:text-primary">The full story →</a>
      </figure>
    </div>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {moreProof.map((item) => (
        <div class="border-t border-border pt-5">
          <p class="m-0 font-mono text-2xl font-semibold text-primary">{item.value}</p>
          <p class="mb-0 mt-2 text-sm leading-6 text-muted-foreground">{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Sherlog -->
  <section class="border-t border-border py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="section-kicker">Sherlog</p>
        <h2 class="section-title">Every role does more than its job title</h2>
        <p class="section-intro">
          Sherlog is the internal agent I built at Bold.org. It started so support could stop waiting on engineering.
          It ended up making everyone better at their job.
        </p>
        <div class="mt-8 rounded-xl border border-primary/30 bg-primary/10 p-5">
          <p class="m-0 font-mono text-4xl font-semibold tracking-tight text-primary">5B+</p>
          <p class="mb-0 mt-2 text-sm text-muted-foreground">tokens a month, across every team</p>
        </div>
        <a href="/blog/internal-company-agent-lessons/" class="mt-6 inline-block text-sm font-semibold text-foreground hover:text-primary">How I built it →</a>
      </div>
      <div class="grid content-start gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2">
        {roles.map((item) => (
          <article class="bg-card p-6">
            <h3 class="m-0 text-lg font-semibold tracking-tight">{item.role}</h3>
            <p class="mb-0 mt-2 text-sm leading-6 text-muted-foreground">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Where AI stalls -->
  <section class="border-t border-border py-16 sm:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="section-kicker">What I set up</p>
      <h2 class="section-title">Writing code got cheap. Shipping didn't.</h2>
      <p class="section-intro">
        Most teams adopted AI one engineer at a time. Output went up, and the work piled up where AI didn't reach.
      </p>
    </div>

    <div class="overflow-hidden rounded-xl border border-border">
      <div class="hidden grid-cols-[11rem_1fr_1fr] gap-8 border-b border-border bg-card px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground md:grid">
        <span></span>
        <span>Where it stalls</span>
        <span class="text-primary">What I set up</span>
      </div>
      {stalls.map((row, index) => (
        <div class:list={["grid gap-3 px-6 py-6 md:grid-cols-[11rem_1fr_1fr] md:gap-8", index > 0 && "border-t border-border"]}>
          <h3 class="m-0 text-lg font-semibold tracking-tight">{row.stage}</h3>
          <p class="m-0 text-base leading-7 text-muted-foreground">{row.stall}</p>
          <p class="m-0 border-l-2 border-primary pl-4 text-base leading-7 text-foreground">{row.fix}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How we start -->
  <section class="border-t border-border py-16 sm:py-20">
    <div class="mb-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16">
      <div class="max-w-2xl">
        <p class="section-kicker">How we start</p>
        <h2 class="section-title">A free call, then a plan with a price</h2>
        <p class="section-intro">
          A defined engagement, not a hire. The goal is that your team doesn't need me when it ends.
        </p>
      </div>
      <p class="m-0 rounded-xl border border-border bg-card p-5 text-sm leading-6 text-muted-foreground">
        <span class="font-semibold text-foreground">Availability:</span> I take on two part-time engagements at a time,
        alongside my role at Bold.org. In person in Cyprus, remote across Europe.
      </p>
    </div>

    <ol class="m-0 grid list-none gap-4 p-0 space-y-0 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li class:list={["relative flex flex-col rounded-xl border p-6", index === 0 ? "border-primary/50 bg-primary/10" : "border-border bg-card"]}>
          <div class="flex items-center justify-between gap-3">
            <span class="font-mono text-sm font-semibold text-primary">{step.step}</span>
            <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-semibold", index === 0 ? "bg-primary text-primary-foreground" : "bg-foreground/10 text-muted-foreground"]}>{step.tag}</span>
          </div>
          <h3 class="mb-0 mt-6 text-xl font-semibold tracking-tight">{step.title}</h3>
          <p class="mb-0 mt-3 text-sm leading-6 text-muted-foreground">{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="py-16 sm:py-24">
    <div class="relative overflow-hidden rounded-2xl border border-primary/30 bg-card px-6 py-12 text-center sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute left-1/2 top-0 size-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/20 blur-3xl"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="m-0 text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-5xl">Where does work wait on your team?</h2>
        <p class="mb-0 mt-5 text-lg leading-8 text-muted-foreground">
          Tell me what you want AI to do for your team. The first call is free, and you get a plan and a price before
          committing to anything.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
          <a href={booking} class="group inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-base font-semibold text-primary-foreground hover:bg-primary/90 hover:text-primary-foreground">
            Book a free intro call
            <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <a href={email} class="text-sm font-semibold text-foreground hover:text-primary">or email me</a>
        </div>
        <p class="mb-0 mt-8 text-sm leading-6 text-muted-foreground">
          Prefer to read first?{" "}
          {posts.map((post, index) => (
            <>
              <a href={post.href} class="font-semibold text-foreground hover:text-primary">{post.title}</a>{index < posts.length - 1 ? " · " : ""}
            </>
          ))}
        </p>
        <p class="mb-0 mt-3 text-xs leading-5 text-muted-foreground">
          Also: scaling engineering teams, architecture reviews and fractional technical leadership.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
