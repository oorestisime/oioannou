---
import { getCollection, render } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import Tag from "../../components/Tag.astro"
import { blogPostSchema } from "../../lib/seo"
import { formatPostDate, getPostExcerpt, getPostSlug, getPostUrl, type BlogPost } from "../../lib/content"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  return posts.map((post) => ({ params: { slug: getPostSlug(post) }, props: { post } }))
}

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const { Content } = await render(post)
const description = getPostExcerpt(post)
const showWorkWithMe = post.data.tags.some((tag) => tag === "AI" || tag === "Agents")
---

<BaseLayout
  title={`${post.data.title} - Orestis Ioannou`}
  description={description}
  canonicalPath={getPostUrl(post)}
  image={post.data.ogImage ?? "/img/blog-by-orestis.jpg"}
  imageAlt={`Blog post: ${post.data.title}`}
  type="article"
  schema={blogPostSchema(post)}
>
  <article class="mx-auto max-w-3xl py-12 sm:py-16">
    <header class="mb-12">
      <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-5xl">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => <Tag name={tag} />)}
        </div>
      </div>
    </header>
    <div class="prose"><Content /></div>
    {showWorkWithMe && (
      <aside class="relative mt-16 overflow-hidden rounded-2xl border border-primary/30 bg-card p-6 sm:p-8">
        <div class="pointer-events-none absolute -right-20 -top-20 size-64 rounded-full bg-primary/15 blur-3xl"></div>
        <div class="relative flex items-center gap-4">
          <img src="/img/me.jpg" alt="" class="size-14 shrink-0 rounded-xl object-cover" width="1024" height="1024" loading="lazy" />
          <div>
            <p class="m-0 text-base font-semibold text-foreground">Orestis Ioannou</p>
            <p class="m-0 text-sm text-muted-foreground">VP of Technology at Bold.org</p>
          </div>
        </div>
        <p class="relative mb-0 mt-6 text-2xl font-semibold leading-tight tracking-[-0.02em] text-foreground">
          I help teams use AI like this.
        </p>
        <p class="relative mb-0 mt-3 text-base leading-7 text-muted-foreground">
          As a contractor, I set up the foundations for your team to use AI well: before the PR, in review, in security
          and across the company. Two part-time engagements at a time, in person in Cyprus and remote across Europe.
        </p>
        <div class="relative mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="https://cal.com/oorestisime/30min" class="group inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90 hover:text-primary-foreground">
            Book a free intro call
            <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <a href="/work-with-me" class="text-sm font-semibold text-foreground hover:text-primary">How I work →</a>
        </div>
      </aside>
    )}
  </article>
</BaseLayout>
